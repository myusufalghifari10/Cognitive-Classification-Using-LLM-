# ── Default: abaikan semua, allow-list di bawah ──
*

# ── Code & config (root) ──
!*.py
!.gitignore
!README.md
!requirements*.txt

# ── Direktori konten ──
# PENTING: !dir/ cuma membuka folder-nya; file di dalamnya tetap kena rule '*'
# di atas. Harus pakai !dir/** untuk membuka isinya juga.
!/data/
!/data/**
!/prompts/
!/prompts/**
!/results/
!/results/**

# ── Catatan internal (jangan dipush) ──
NOTE.md

# ── Backup / file antara (jangan dipush) ──
*.bak
*.premerge

# ── Python artifacts ──
__pycache__/
*.pyc
*.pyo

# ── OS / editor junk ──
.DS_Store
Thumbs.db

# ── Filter hasil benchmark: simpan laporan, abaikan aset besar ──
/results/**/*.png
/results/**/*.jsonl
!/results/**/*report*.txt
!/results/**/*report*.md

Report.pdf
